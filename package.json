{
  "name": "dny",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "龙与耶维城 — 八层 + 终局的重置式增量放置游戏（数值 = docs/数值设计.md V8）",
  "scripts": {
    "start": "node server.mjs 8080",
    "verify": "node tools/v8-verify.mjs && node tools/v8-engine-verify.mjs && node tools/v8-audit.mjs && node tools/v8-save-verify.mjs",
    "verify:four": "node tools/v8-verify.mjs --four",
    "ref": "node tools/extract-reference.mjs",
    "sim": "node sim/run.mjs",
    "sim:full": "node sim/simulate.mjs",
    "probe": "node sim/probe.mjs 300",
    "doc:balance": "node tools/gen-balance-doc.mjs",
    "test:e2e": "node test/v8.e2e.mjs",
    "test:net": "node test/net.e2e.mjs"
  },
  "dependencies": {
    "vue": "^2.6.14"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
